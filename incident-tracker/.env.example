# ---------- Required (server refuses to start without these) ----------
# Supabase: Project Settings -> Database -> Connection string (use the pooler URI on port 6543 or direct 5432)
DATABASE_URL=postgres://postgres:password@localhost:5432/gatekeeper
WHATSAPP_ACCESS_TOKEN=EAAG...            # Meta system-user permanent token
WHATSAPP_PHONE_NUMBER_ID=123456789012345 # WhatsApp Manager -> API Setup
WHATSAPP_GROUP_ID=                        # Supervisors' group ID (Cloud API Groups)
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string

# ---------- Optional ----------
PORT=3000
# Log outgoing WhatsApp messages to the console instead of calling Meta.
MOCK_WHATSAPP_API=true
# Set true for Supabase / any TLS-only Postgres.
DATABASE_SSL=false
# Verify X-Hub-Signature-256 on inbound webhooks (Meta App -> Settings -> Basic -> App secret). Strongly recommended.
WHATSAPP_APP_SECRET=
# Shared key the steward form sends as x-api-key. Leave blank only on a closed network.
STEWARD_API_KEY=
# Set to "group" if your Cloud API account requires recipient_type for group sends.
WHATSAPP_RECIPIENT_TYPE=
WHATSAPP_API_VERSION=v21.0
COOL_OFF_MINUTES=30
TZ_DISPLAY=Europe/London
OFFLINE_LOG_PATH=offline_incidents.log
